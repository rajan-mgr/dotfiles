# ~/.config/hypr/hyprlock.conf

background {
    monitor =
    path = __WALLPAPER__
    blur_passes = 3
    blur_size = 10
    noise = 0.01
    contrast = 1.0
    brightness = 0.9
}

# Hour
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H")"
    color = rgba(255, 255, 255, 0.9)
    font_size = 120
    font_family = JetBrainsMono Nerd Font
    position = 0, 120
    halign = center
    valign = center
}

# Minute
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%M")"
    color = rgba(255, 255, 255, 0.9)
    font_size = 120
    font_family = JetBrainsMono Nerd Font
    position = 0, -30
    halign = center
    valign = center
}

# Day of week
label {
    monitor =
    text = cmd[update:60000] echo "$(date +"%A")"
    color = rgba(255, 255, 255, 0.6)
    font_size = 22
    font_family = JetBrainsMono Nerd Font
    position = 0, -160
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] echo "$(date +"%d %b")"
    color = rgba(255, 255, 255, 0.5)
    font_size = 16
    font_family = JetBrainsMono Nerd Font
    position = 0, -195
    halign = center
    valign = center
}

# Password input pill
input-field {
    monitor =
    size = 250, 45
    outline_thickness = 0
    rounding = 25
    outer_color = rgba(0, 0, 0, 0)
    inner_color = rgba(255, 255, 255, 0.08)
    font_color = rgba(255, 255, 255, 0.9)
    fade_on_empty = false
    placeholder_text =
    dots_size = 0.2
    dots_spacing = 0.3
    dots_center = true
    position = 0, -250
    halign = center
    valign = center
}
